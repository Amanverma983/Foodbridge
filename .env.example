# ==============================================================================
# FoodBridge — Save Food, Feed People
# Environment Configuration
# ==============================================================================

# Backend API Port & Host
PORT=8000
HOST=0.0.0.0

# Database & Storage
# In local demo mode, FoodBridge automatically initializes and persists to SQLite (backend/foodbridge.db)
# and browser localStorage. No external credentials required.
DATABASE_URL=sqlite:///./foodbridge.db

# Production Supabase PostgreSQL & Auth (Optional)
# When provided, FoodBridge seamlessly switches to Supabase PostgreSQL and authentication.
# Never expose the Supabase service-role secret key in the client!
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Map Tile Configuration
# Uses OpenStreetMap by default (free, no token needed)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_CITY_DEFAULT=Noida
VITE_LAT_DEFAULT=28.5700
VITE_LNG_DEFAULT=77.3500
